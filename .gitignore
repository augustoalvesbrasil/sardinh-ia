# ============================================================
# SARDINH-IA — .gitignore
# ============================================================

# --- Backup local (nunca vai pro git) ---
_backup/

# --- Credenciais e tokens (NUNCA subir) ---
credentials.json
token.json
*.json.bak
Cliente OAuth.txt
.env
.env.*

# --- Dados do Cérebro (pesados, não são código) ---
cerebro_pdf/
cerebro_txt/

# --- Dados operacionais gerados em runtime ---
gestao_local/base_conhecimento_auvp.csv
gestao_local/relatorio_checkup.txt

# --- Build / Distribuição (PyInstaller) ---
build/
dist/
output/

# --- Pacote de distribuição ---
*.zip
*.exe

# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.pyo
.Python

# --- Ambientes virtuais ---
.venv
venv/
env/
ENV/
env.bak/
venv.bak/

# --- IDEs ---
.vscode/
.idea/
*.suo
*.user

# --- Outros ---
.DS_Store
Thumbs.db
